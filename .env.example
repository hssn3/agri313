# SmartAgri Environment Variables
# این فایل را کپی کنید با نام .env و مقادیر را پر کنید

PORT=3000
NODE_ENV=development

# در آینده برای احراز هویت:
# JWT_SECRET=your-secret-key-here
# DB_URL=postgresql://user:pass@localhost:5432/smartagri

# اختیاری — یکپارچه‌سازی با Gemini AI (برای نسخه‌های آینده):
# GEMINI_API_KEY=your-gemini-key
