{
  "name": "smartagri-analyze",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/.bin/tsc -p tsconfig.app.json && node node_modules/.bin/vite build",
    "build:version": "node scripts/bump-version.mjs patch \"بهبودهای خودکار\" && npm run build",
    "build:minor": "node scripts/bump-version.mjs minor && npm run build",
    "build:major": "node scripts/bump-version.mjs major && npm run build",
    "preview": "vite preview",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "npx tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server:dev\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "devDependencies": {}
}
